# Frontend URL pública (Vercel); también se usa en enlaces de seguimiento de emails
FRONTEND_URL=http://localhost:5173

# PostgreSQL administrado (Neon). Copiá la cadena pooled de Neon.
DATABASE_URL=
PG_POOL_MAX=5
# La conexión TLS está activada por defecto; solo usar disable para pruebas locales.
PGSSL=

# Mercado Pago (usar credenciales de prueba inicialmente)
MP_ACCESS_TOKEN=
MP_ENVIRONMENT=test
MP_WEBHOOK_SECRET=

# Acceso al panel de administración
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Correos transaccionales (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Con Vercel como proxy, mantener SameSite=Lax; en producción las cookies usan Secure.
SESSION_COOKIE_SAME_SITE=lax
