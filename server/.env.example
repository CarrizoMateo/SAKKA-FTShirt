# Copiá este archivo a server/.env para desarrollo. En Render van como "Environment Variables".
# NUNCA subas el .env real ni pegues estos valores en chats.

# Neon (Connection string, la que incluye ?sslmode=require)
DATABASE_URL=

# Mercado Pago (Credenciales de producción de tu aplicación)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Panel de administración
ADMIN_USER=
# Generalo con:  npm run hash-password -- "tu contraseña larga"
ADMIN_PASSWORD_HASH=
# 32+ caracteres al azar (por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_SESSION_SECRET=

# URL pública de la tienda (Vercel). Se puede poner más de una separadas por coma.
FRONTEND_URL=https://sakka-ftshirt.vercel.app
# URL pública del backend (Render): Mercado Pago avisa los pagos acá
BACKEND_URL=https://sakka-ftshirt.onrender.com

# Mails automáticos (Resend)
RESEND_API_KEY=
EMAIL_FROM=SAKKA <pedidos@tu-dominio.com>

NODE_ENV=production
