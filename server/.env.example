# API
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Mercado Pago (credenciales PRIVADAS: solo en el servidor)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Acceso al panel de administracion
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Correos transaccionales (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Opcionales
# En local queda "lax"; en produccion el codigo usa "none" por defecto
# Para API y tienda bajo el mismo dominio, se puede establecer en "lax".
SESSION_COOKIE_SAME_SITE=

# Para Render con disco persistente montado en /var/data:
# DB_PATH=/var/data/sakka.db
DB_PATH=
